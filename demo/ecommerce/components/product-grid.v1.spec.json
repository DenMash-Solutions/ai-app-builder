{
  "root": "grid-root",
  "elements": {
    "grid-root": {
      "type": "Grid",
      "props": { "columns": 3, "gap": "md" },
      "repeat": { "statePath": "/filtered-items", "key": "id" },
      "watch": {
        "/queries/productsList/data": [
          {
            "action": "setState",
            "params": {
              "statePath": "/filtered-items",
              "value": {
                "$computed": "filterItems",
                "args": {
                  "source": { "$state": "/queries/productsList/data" },
                  "query": { "$state": "/query" },
                  "fields": ["name", "category"]
                }
              }
            }
          }
        ]
      },
      "children": ["slot-card"]
    },
    "slot-card": {
      "type": "Stack",
      "props": { "direction": "vertical", "gap": "sm" },
      "children": []
    }
  }
}
