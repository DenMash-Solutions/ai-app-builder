{
  "root": "checkout-root",
  "route": "checkout",
  "state": {
    "hasSidebar": false,
    "cartOpen": false,
    "shipName": "",
    "shipStreet": "",
    "shipCity": "",
    "shipPostal": "",
    "shipCountry": ""
  },
  "dataSources": {
    "browserStore": { "provider": "localStorage", "config": {} },
    "storefront": {
      "provider": "api",
      "config": {
        "baseUrl": "http://localhost:3000/api-public",
        "auth": { "type": "bearer", "ref": "ecommerce" }
      }
    }
  },
  "resources": {
    "cartItems": {
      "dataSource": "browserStore",
      "schema": {
        "id": "string",
        "name": "string",
        "price": "number",
        "qty": "number",
        "lineTotal": "number"
      }
    },
    "customers": {
      "dataSource": "storefront",
      "collection": "customers",
      "schema": {
        "id": "string",
        "name": "string",
        "email": "string",
        "street": "string",
        "city": "string",
        "postal": "string",
        "country": "string"
      }
    },
    "orders": {
      "dataSource": "browserStore",
      "schema": {
        "id": "string",
        "status": "string",
        "total": "number",
        "itemCount": "number"
      }
    }
  },
  "queries": {
    "cartList": { "resource": "cartItems", "operation": "list" },
    "customersList": { "resource": "customers", "operation": "list" }
  },
  "elements": {
    "checkout-root": {
      "type": "Stack",
      "props": { "direction": "vertical", "gap": "md" },
      "watch": {
        "/queries/customersList/data": [
          {
            "action": "setState",
            "params": {
              "statePath": "/shipName",
              "value": { "$state": "/queries/customersList/data/0/name" }
            }
          },
          {
            "action": "setState",
            "params": {
              "statePath": "/shipStreet",
              "value": { "$state": "/queries/customersList/data/0/street" }
            }
          },
          {
            "action": "setState",
            "params": {
              "statePath": "/shipCity",
              "value": { "$state": "/queries/customersList/data/0/city" }
            }
          },
          {
            "action": "setState",
            "params": {
              "statePath": "/shipPostal",
              "value": { "$state": "/queries/customersList/data/0/postal" }
            }
          },
          {
            "action": "setState",
            "params": {
              "statePath": "/shipCountry",
              "value": { "$state": "/queries/customersList/data/0/country" }
            }
          }
        ]
      },
      "children": [
        "slot-navbar",
        "checkout-heading",
        "checkout-form",
        "slot-summary",
        "checkout-place",
        "checkout-note"
      ]
    },
    "slot-navbar": {
      "type": "Stack",
      "props": { "direction": "vertical", "gap": "md" },
      "children": []
    },
    "checkout-heading": {
      "type": "Heading",
      "props": { "text": "Checkout", "level": "h1" }
    },
    "checkout-form": {
      "type": "Stack",
      "props": { "direction": "vertical", "gap": "sm" },
      "children": ["ci-name", "ci-street", "ci-city", "ci-postal", "ci-country"]
    },
    "ci-name": {
      "type": "Input",
      "props": {
        "label": "Full name",
        "name": "ship-name",
        "value": { "$bindState": "/shipName" },
        "checks": [{ "type": "required", "message": "Name is required" }],
        "validateOn": "change"
      },
      "watch": {
        "/shipName": {
          "action": "validateForm",
          "params": { "statePath": "/formValidation" }
        }
      }
    },
    "ci-street": {
      "type": "Input",
      "props": {
        "label": "Street address",
        "name": "ship-street",
        "value": { "$bindState": "/shipStreet" },
        "checks": [{ "type": "required", "message": "Street is required" }],
        "validateOn": "change"
      },
      "watch": {
        "/shipStreet": {
          "action": "validateForm",
          "params": { "statePath": "/formValidation" }
        }
      }
    },
    "ci-city": {
      "type": "Input",
      "props": {
        "label": "City",
        "name": "ship-city",
        "value": { "$bindState": "/shipCity" },
        "checks": [{ "type": "required", "message": "City is required" }],
        "validateOn": "change"
      },
      "watch": {
        "/shipCity": {
          "action": "validateForm",
          "params": { "statePath": "/formValidation" }
        }
      }
    },
    "ci-postal": {
      "type": "Input",
      "props": {
        "label": "Postal code",
        "name": "ship-postal",
        "value": { "$bindState": "/shipPostal" },
        "checks": [
          { "type": "required", "message": "Postal code is required" }
        ],
        "validateOn": "change"
      },
      "watch": {
        "/shipPostal": {
          "action": "validateForm",
          "params": { "statePath": "/formValidation" }
        }
      }
    },
    "ci-country": {
      "type": "Input",
      "props": {
        "label": "Country",
        "name": "ship-country",
        "value": { "$bindState": "/shipCountry" },
        "checks": [{ "type": "required", "message": "Country is required" }],
        "validateOn": "change"
      },
      "watch": {
        "/shipCountry": {
          "action": "validateForm",
          "params": { "statePath": "/formValidation" }
        }
      }
    },
    "slot-summary": {
      "type": "Stack",
      "props": { "direction": "vertical", "gap": "sm" },
      "children": []
    },
    "checkout-place": {
      "type": "Button",
      "props": { "label": "Place order" },
      "disabled": {
        "$cond": { "$state": "/formValidation/valid" },
        "$then": false,
        "$else": true
      },
      "on": {
        "press": [
          {
            "action": "data_mutate",
            "params": {
              "op": "create",
              "resource": "orders",
              "input": {
                "status": "placed",
                "total": {
                  "$math": "add",
                  "a": {
                    "$agg": "sum",
                    "items": { "$state": "/queries/cartList/data" },
                    "field": "lineTotal"
                  },
                  "b": 5
                },
                "itemCount": {
                  "$count": { "$state": "/queries/cartList/data" }
                },
                "items": { "$state": "/queries/cartList/data" }
              }
            }
          },
          { "action": "navigate", "params": { "screen": "Orders" } }
        ]
      }
    },
    "checkout-note": {
      "type": "Text",
      "props": {
        "text": "Orders are stored in your browser for this demo.",
        "variant": "caption"
      }
    }
  }
}
