{
  "root": "pd-root",
  "route": "products/{id}",
  "state": {
    "hasSidebar": true,
    "cartOpen": false,
    "qty": 1,
    "added": false,
    "price": 0,
    "compareAt": null
  },
  "dataSources": {
    "browserStore": { "provider": "localStorage", "config": {} },
    "storefront": {
      "provider": "api",
      "config": {
        "baseUrl": "http://localhost:3000/api-public",
        "auth": { "type": "bearer", "ref": "ecommerce" }
      }
    }
  },
  "resources": {
    "cartItems": {
      "dataSource": "browserStore",
      "schema": {
        "id": "string",
        "name": "string",
        "price": "number",
        "qty": "number",
        "lineTotal": "number"
      }
    },
    "products": {
      "dataSource": "storefront",
      "collection": "products",
      "schema": {
        "id": "string",
        "name": "string",
        "price": "number",
        "onSale": "boolean",
        "category": "string"
      }
    }
  },
  "queries": {
    "cartList": { "resource": "cartItems", "operation": "list" },
    "productsDetail": {
      "resource": "products",
      "operation": "get",
      "params": { "id": { "$state": "/id" } }
    }
  },
  "elements": {
    "pd-root": {
      "type": "Stack",
      "props": { "direction": "vertical", "gap": "md" },
      "watch": {
        "/queries/productsDetail/data": [
          {
            "action": "setState",
            "params": {
              "statePath": "/price",
              "value": {
                "$state": "/queries/productsDetail/data/0/price"
              }
            }
          },
          {
            "action": "setState",
            "params": {
              "statePath": "/compareAt",
              "value": {
                "$coalesce": [
                  { "$state": "/queries/productsDetail/data/0/compareAt" },
                  null
                ]
              }
            }
          }
        ]
      },
      "children": ["slot-navbar", "pd-loading", "pd-block", "slot-sidebar"]
    },
    "slot-navbar": {
      "type": "Stack",
      "props": { "direction": "vertical", "gap": "md" },
      "children": []
    },
    "pd-loading": {
      "type": "Text",
      "props": { "text": "Loading product…", "variant": "muted" },
      "visible": { "$state": "/queries/productsDetail/status", "eq": "loading" }
    },
    "pd-block": {
      "type": "Stack",
      "props": { "direction": "vertical", "gap": "md" },
      "visible": {
        "$state": "/queries/productsDetail/status",
        "eq": "success"
      },
      "children": [
        "pd-image",
        "pd-name",
        "slot-price",
        "pd-desc",
        "pd-qty",
        "pd-add",
        "pd-added"
      ]
    },
    "pd-image": {
      "type": "Image",
      "props": {
        "src": { "$state": "/queries/productsDetail/data/0/image" },
        "alt": { "$state": "/queries/productsDetail/data/0/name" },
        "width": 400,
        "height": 300
      }
    },
    "pd-name": {
      "type": "Heading",
      "props": {
        "text": { "$state": "/queries/productsDetail/data/0/name" },
        "level": "h1"
      }
    },
    "slot-price": {
      "type": "Stack",
      "props": { "direction": "horizontal", "gap": "sm", "align": "center" },
      "children": []
    },
    "pd-desc": {
      "type": "Text",
      "props": {
        "text": { "$state": "/queries/productsDetail/data/0/description" },
        "variant": "muted"
      }
    },
    "pd-qty": {
      "type": "Stack",
      "props": { "direction": "horizontal", "gap": "sm", "align": "center" },
      "children": ["pd-qty-label", "pd-minus", "pd-qty-value", "pd-plus"]
    },
    "pd-qty-label": {
      "type": "Text",
      "props": { "text": "Quantity" }
    },
    "pd-minus": {
      "type": "Button",
      "props": { "label": "−", "variant": "secondary" },
      "on": {
        "press": [
          {
            "action": "setState",
            "params": {
              "statePath": "/qty",
              "value": {
                "$math": "max",
                "a": { "$math": "subtract", "a": { "$state": "/qty" }, "b": 1 },
                "b": 1
              }
            }
          }
        ]
      }
    },
    "pd-qty-value": {
      "type": "Text",
      "props": { "text": { "$state": "/qty" } }
    },
    "pd-plus": {
      "type": "Button",
      "props": { "label": "+" },
      "on": {
        "press": [
          {
            "action": "setState",
            "params": {
              "statePath": "/qty",
              "value": {
                "$math": "add",
                "a": { "$state": "/qty" },
                "b": 1
              }
            }
          }
        ]
      }
    },
    "pd-add": {
      "type": "Button",
      "props": { "label": "Add to cart" },
      "on": {
        "press": [
          {
            "action": "data_mutate",
            "params": {
              "op": "create",
              "resource": "cartItems",
              "input": {
                "name": { "$state": "/queries/productsDetail/data/0/name" },
                "price": { "$state": "/queries/productsDetail/data/0/price" },
                "qty": { "$state": "/qty" },
                "lineTotal": {
                  "$math": "multiply",
                  "a": { "$state": "/queries/productsDetail/data/0/price" },
                  "b": { "$state": "/qty" }
                }
              }
            }
          },
          {
            "action": "setState",
            "params": { "statePath": "/added", "value": true }
          },
          {
            "action": "setState",
            "params": { "statePath": "/qty", "value": 1 }
          }
        ]
      }
    },
    "pd-added": {
      "type": "Badge",
      "props": { "text": "Added to cart" },
      "visible": { "$state": "/added" }
    },
    "slot-sidebar": {
      "type": "Stack",
      "props": { "direction": "vertical", "gap": "md" },
      "children": []
    }
  }
}
