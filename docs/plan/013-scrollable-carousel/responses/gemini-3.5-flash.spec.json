{
  "root": "main-container",
  "elements": {
    "main-container": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg",
        "className": "py-12 px-6 md:px-12 max-w-7xl mx-auto bg-background text-foreground"
      },
      "children": ["header-stack", "carousel-container"]
    },
    "header-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "xs",
        "className": "max-w-2xl"
      },
      "children": ["header-tag", "header-title", "header-desc"]
    },
    "header-tag": {
      "type": "Text",
      "props": {
        "text": "ESSENTIALS COLLECTION",
        "variant": "caption",
        "className": "tracking-[0.2em] text-xs font-semibold text-muted-foreground uppercase"
      },
      "children": []
    },
    "header-title": {
      "type": "Heading",
      "props": {
        "text": "The Skin Sanctuary",
        "level": "h1",
        "className": "font-serif text-3xl md:text-4xl tracking-tight text-foreground font-light"
      },
      "children": []
    },
    "header-desc": {
      "type": "Text",
      "props": {
        "text": "Artisanal formulations crafted to respect, nurture, and elevate your skin's natural intelligence. Single-origin botanicals meets advanced biocompatible science.",
        "variant": "lead",
        "className": "text-sm md:text-base text-muted-foreground font-light leading-relaxed mt-2"
      },
      "children": []
    },
    "carousel-container": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md",
        "className": "overflow-x-auto snap-x scrollbar-none pb-6 -mx-6 px-6 md:-mx-12 md:px-12 flex-nowrap"
      },
      "repeat": {
        "statePath": "/products",
        "key": "id"
      },
      "children": ["product-card"]
    },
    "product-card": {
      "type": "Card",
      "props": {
        "className": "shrink-0 w-64 md:w-72 snap-start border-none shadow-none bg-transparent select-none"
      },
      "children": ["card-image-container", "card-info-stack"]
    },
    "card-image-container": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "className": "relative aspect-[3/4] bg-muted rounded-md overflow-hidden mb-4 group cursor-pointer"
      },
      "children": ["card-image", "card-badge"]
    },
    "card-image": {
      "type": "Image",
      "props": {
        "src": {
          "$item": "image"
        },
        "alt": {
          "$item": "name"
        },
        "className": "object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"
      },
      "children": []
    },
    "card-badge": {
      "type": "Badge",
      "props": {
        "text": {
          "$item": "badge"
        },
        "variant": "secondary",
        "className": "absolute top-3 left-3 bg-white/90 dark:bg-zinc-900/90 backdrop-blur-sm text-[10px] font-semibold tracking-widest uppercase px-2 py-0.5 rounded-none border border-border/50 text-foreground"
      },
      "visible": {
        "$item": "badge"
      },
      "children": []
    },
    "card-info-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "xs",
        "className": "px-1"
      },
      "children": ["card-brand", "card-name", "card-desc", "card-price-row"]
    },
    "card-brand": {
      "type": "Text",
      "props": {
        "text": {
          "$item": "brand"
        },
        "variant": "caption",
        "className": "uppercase tracking-[0.15em] text-[10px] text-muted-foreground font-bold"
      },
      "children": []
    },
    "card-name": {
      "type": "Heading",
      "props": {
        "text": {
          "$item": "name"
        },
        "level": "h4",
        "className": "font-serif text-base text-foreground font-medium tracking-tight mt-0.5"
      },
      "children": []
    },
    "card-desc": {
      "type": "Text",
      "props": {
        "text": {
          "$item": "desc"
        },
        "variant": "muted",
        "className": "text-xs text-muted-foreground/80 line-clamp-1 font-light"
      },
      "children": []
    },
    "card-price-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "justify": "between",
        "align": "center",
        "className": "mt-2 pt-2 border-t border-border/40"
      },
      "children": ["card-price", "card-action"]
    },
    "card-price": {
      "type": "Text",
      "props": {
        "text": {
          "$template": "$${price}"
        },
        "className": "font-mono text-sm text-foreground/90 font-medium"
      },
      "children": []
    },
    "card-action": {
      "type": "Button",
      "props": {
        "label": "ADD TO BAG",
        "variant": "secondary",
        "className": "h-7 text-[10px] tracking-wider px-3 py-0 rounded-none border border-border hover:bg-foreground hover:text-background dark:hover:bg-foreground dark:hover:text-background transition-all duration-300 font-medium"
      },
      "children": []
    }
  },
