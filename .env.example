# Copy to .env.local and fill in. NEVER commit .env.local (covered by .gitignore).

# Google Gemini via Vercel AI SDK (UI generation)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Supabase (accounts, sync, publish)
# The anon/publishable key is a PUBLIC client key (safe to ship to browsers);
# never put service_role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# --- Optional: Playwright e2e (docs/plan/e2e-hardening) ----------------------
# Dedicated test identities — NEVER a personal account. Suites skip cleanly
# when unset; values that are set but wrong fail fast at setup.

# Admin identity: logs in for the authed suite (sync, publish, admin, sign-out).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Non-admin identity: the signed-in /admin denial test.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Fixture data owner: owns the seeded featured landing rows only.
# Default when unset: anon@e2e.com
E2E_FIXTURE_EMAIL=

# Service-role key (Dashboard → Settings → API). Server-side only — Node in
# Playwright setup/tests, never the browser bundle. Enables the fixture seed,
# featured-pointer recovery, and the leftover sweep; unset → all skip with a
# warning and the admin feature/unfeature test skips too.
SUPABASE_SERVICE_ROLE_KEY=
